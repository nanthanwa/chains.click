{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chains.click/schemas/icon.json",
  "title": "Chain Icon",
  "description": "Schema for chain icon definition",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["url", "width", "height", "format"],
    "properties": {
      "url": {
        "type": "string",
        "description": "IPFS URL to the icon",
        "pattern": "^ipfs://"
      },
      "width": {
        "type": "integer",
        "description": "Icon width in pixels",
        "minimum": 16,
        "maximum": 1024
      },
      "height": {
        "type": "integer",
        "description": "Icon height in pixels",
        "minimum": 16,
        "maximum": 1024
      },
      "format": {
        "type": "string",
        "description": "Image format",
        "enum": ["png", "svg", "jpg", "jpeg"]
      }
    },
    "additionalProperties": false
  },
  "minItems": 1
}
