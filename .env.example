# Cloudflare Configuration
# Copy this file to .env and fill in your values
# These values can also be set in .dev.vars for local wrangler development

# Cloudflare Account ID (found in Cloudflare dashboard)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token (create at https://dash.cloudflare.com/profile/api-tokens)
# Required permissions: Cloudflare Pages:Edit, Workers KV Storage:Edit
CLOUDFLARE_API_TOKEN=
